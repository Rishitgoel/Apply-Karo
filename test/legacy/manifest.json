{
  "manifest_version": 3,
  "name": "Apply karo - Smart Autofill Assistant",
  "version": "1.0.0",
  "description": "Autofills job applications, uploads resumes, generates cover letters, and learns from manual edits using local storage and Gemini AI.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "all_frames": true,
      "js": ["storage.js", "gemini.js", "field_rules.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
